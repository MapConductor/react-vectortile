{
  "name": "@mapconductor/react-vectortile",
  "version": "0.3.0",
  "description": "Render MapLibre vector styles as raster tiles on any MapConductor backend",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": "./vendor/vectortile/dist/worker.js"
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/fetch-vector-assets.mjs",
    "build": "tsup",
    "predev": "node scripts/fetch-vector-assets.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "echo 'covered by the harness in mapconductor-vectortile'"
  },
  "keywords": [
    "maps",
    "vector-tiles",
    "maplibre",
    "react",
    "typescript"
  ],
  "author": "MapConductor",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MapConductor/react-vectortile.git"
  },
  "dependencies": {
    "@mapconductor/js-sdk-core": "^0.3.0",
    "@mapconductor/js-sdk-react": "^0.3.0",
    "@mapconductor/js-vectorstyle": "^0.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
